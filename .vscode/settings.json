{
  // Force every .js file to use the JavaScript language service
  "files.associations": {
    "*.js": "javascript",
    "*.JS": "javascript",
    "*.mjs": "javascript",
    "*.cjs": "javascript"
  },

  // Automatic suggestions while typing
  "editor.quickSuggestions": {
    "other": true,
    "comments": true,
    "strings": true
  },
  "editor.quickSuggestionsDelay": 0,
  "editor.suggestOnTriggerCharacters": true,
  "editor.wordBasedSuggestions": "matchingDocuments",
  "editor.wordBasedSuggestionsMode": "matchingDocuments",
  "editor.suggest.showWords": true,
  "editor.suggest.showSnippets": true,
  "editor.suggest.showFunctions": true,
  "editor.suggest.showVariables": true,
  "editor.suggest.showProperties": true,
  "editor.suggest.showMethods": true,
  "editor.suggest.showKeywords": true,
  "editor.suggest.minTriggerInputLength": 1,

  // Accepting suggestions
  "editor.acceptSuggestionOnEnter": "on",
  "editor.tabCompletion": "on",
  "editor.snippetSuggestions": "top",
  "editor.suggestSelection": "first",
  "editor.parameterHints.enabled": true,

  // JavaScript-specific IntelliSense
  "javascript.suggest.enabled": true,
  "javascript.suggest.autoImports": true,
  "javascript.suggest.completeFunctionCalls": true,
  "javascript.suggest.names": true,
  "javascript.suggest.paths": true,
  "javascript.validate.enable": true,

  // AI inline suggestions (Copilot / Antigravity / other providers)
  "editor.inlineSuggest.enabled": true
}
